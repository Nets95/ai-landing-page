/coverage
*.test.js.snap
.nyc_output/
/tests/screenshots/
/tests/results/
playwright-report/
test-results/

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
*.log
nul

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# env files
.env
.env*.local
.env.production
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# OS
Thumbs.db
.DS_Store
*.bak
*.tmp
*.temp
*~

